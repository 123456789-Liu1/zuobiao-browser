<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="6dp"
        android:paddingRight="8dp">

        <TextView
            android:id="@+id/btnBack"
            style="@style/ToolIcon"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:text="←"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="4dp"
            android:singleLine="true"
            android:ellipsize="middle"
            android:text="源代码"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/modeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnFind"
            style="@style/ToolIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="⌕"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnMore"
            style="@style/ToolIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="⋮"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/findRow"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:paddingLeft="10dp"
        android:paddingRight="4dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/findInput"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_url"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:hint="在源码中查找"
            android:textColorHint="@color/text_dim"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:singleLine="true"
            android:inputType="text" />

        <TextView
            android:id="@+id/findCount"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minWidth="52dp"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/findPrev"
            style="@style/ToolIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="↑"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/findNext"
            style="@style/ToolIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="↓"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/findClose"
            style="@style/ToolIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="✕"
            android:textSize="15sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:indeterminate="true"
        android:progressTint="@color/accent"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:id="@+id/code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textIsSelectable="true"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:typeface="monospace"
            android:lineSpacingExtra="2dp" />
    </ScrollView>
</LinearLayout>
